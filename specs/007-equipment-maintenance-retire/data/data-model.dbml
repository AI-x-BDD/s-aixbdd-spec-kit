// Data Model: 設備送修與停用、恢復可用及受影響未來預約的處理 (Equipment Maintenance and Retirement)
// Spec: specs/007-equipment-maintenance-retire/spec.md
// Date: 2026-11-10

Project "equipment-maintenance-retire" {
  database_type: 'PostgreSQL'
  Note: '涵蓋 D1 帳號、驗證碼挑戰與工作階段資料存取，D2 設備狀態與設備狀態變更紀錄持久化，D3 預約借還紀錄（含取消原因）與改期申請持久化。延續 006-reservation-reschedule 的 users、captcha_challenges、sessions、equipments、time_slots、reservations、reschedule_requests 結構；本次以一支增量遷移完成 4 件事：把 equipment_status 的 unavailable 原地改名為 retired 並新增 maintenance、新增 reservation_cancel_reason Enum 與 reservations.cancel_reason 欄位（既有 cancelled 資料列補上 member_cancelled）、新增 equipment_status_changes 資料表、新增 idx_reservations_equipment_status_date 索引。其餘欄位、Enum 與索引不變，既有資料列的其他欄位值都不改寫，達成無損遷移（FR-018）。每張持久化資料表皆具備生命週期欄位並採用軟刪除（設定 deleted_at），查詢有效資料時皆排除 deleted_at 不為 null 的資料列。'
}

// ---------- Enums ----------

Enum user_role {
  member [note: '一般成員：可預約「可用」設備、在「我的預約」查看取消原因與歷史紀錄；呼叫設定送修、停用或恢復可用時被拒絕（FR-015、FR-016、FR-017、SC-005）']
  admin [note: '管理員：唯一可以設定送修、停用與恢復可用的角色，並保留審核預約、改期審核、切換審核設定、登記領取與歸還等前四次迭代的權限（FR-017、FR-018）']
}

Enum equipment_status {
  available [note: '可用：只有此狀態的設備可以被預約，成員設備清單顯示（FR-006、FR-011）']
  maintenance [note: '送修中：暫時不可用，仍出現在成員設備清單並標示「送修中」，不能預約，沒有結束日期；本次遷移以 ADD VALUE 新增，排序在 retired 之前（FR-001、FR-006、FR-014）']
  retired [note: '停用：長期不可用，不出現在成員設備清單，只有管理員看得到，不能預約，沒有結束日期；由 006 的 unavailable 原地改名而來，既有不可用設備遷移後即為停用（FR-001、FR-006、FR-014、FR-018）']
}

Enum reservation_status {
  pending_approval [note: '待審核：不占用時段；設備設為送修或停用時，時段尚未結束的此狀態預約一併改為 cancelled（FR-002、FR-018）']
  confirmed [note: '已核准／有效：占用該設備時段；設備設為送修或停用時，時段尚未結束且尚未登記領取的此狀態預約改為 cancelled（FR-002、FR-003、FR-018）']
  checked_out [note: '借用中：設備有此狀態的預約時拒絕設為送修或停用，包含已超過時段結束時間仍未歸還的借用（FR-005、FR-018）']
  returned [note: '已歸還：已結束紀錄，設定送修、停用與恢復可用都不改變（FR-002、FR-016、FR-018）']
  rejected [note: '已駁回：已結束紀錄，設定送修、停用與恢復可用都不改變（FR-002、FR-018）']
  cancelled [note: '已取消：成員本人取消，或因設備送修、停用由系統取消，以 cancel_reason 區分；設備恢復可用時不復原（FR-002、FR-012、FR-015）']
}

Enum reservation_cancel_reason {
  member_cancelled [note: '成員取消：成員本人於時段開始前取消；遷移時為既有 cancelled 資料列補上此值；「我的預約」不顯示設備原因（FR-015、FR-018）']
  equipment_maintenance [note: '設備送修：設備設為送修中時由系統取消，顯示「設備送修」（FR-002、FR-003、FR-015、FR-020）']
  equipment_retired [note: '設備停用：設備設為停用時由系統取消，顯示「設備停用」（FR-002、FR-003、FR-015、FR-020）']
}

Enum reschedule_request_status {
  pending_approval [note: '改期審核中：原預約維持 confirmed；原預約因設備送修或停用被取消時，同一交易內改為 expired（FR-004、FR-018）']
  approved [note: '改期成功（FR-018）']
  rejected [note: '改期被駁回（FR-018）']
  withdrawn [note: '改期已撤回（FR-018）']
  expired [note: '改期已失效：之後管理員不能核准；設備恢復可用時不復原（FR-004、FR-012）']
}

Enum reschedule_expire_reason {
  original_slot_started [note: '原時段的開始時間到達（FR-018）']
  new_slot_started [note: '新時段早於原時段且開始時間先到達（FR-018）']
  reservation_cancelled [note: '原預約已取消：包含成員取消原預約，以及原預約因設備送修或停用被系統取消；本次沿用此值，不新增 Enum 值（FR-004、FR-018）']
  reservation_checked_out [note: '管理員對原預約登記領取（FR-018）']
}

// ---------- Tables ----------

// D1 帳號、驗證碼挑戰與工作階段資料存取
Table users {
  id uuid [pk, note: '使用者唯一識別碼']
  username varchar(64) [not null, unique, note: '登入帳號（FR-018）']
  password_hash varchar(255) [not null, note: '以 crypto.scrypt 雜湊後的密碼字串（FR-018）']
  display_name varchar(100) [not null, note: '顯示名稱；設備清單以 equipment_status_changes.changed_by 對應此欄，顯示最近一次狀態變更的管理員名稱（FR-008）']
  role user_role [not null, default: 'member', note: '使用者角色；設定送修、停用與恢復可用限 admin（FR-017、SC-005）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；系統預建或匿名操作時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null']

  indexes {
    (role, deleted_at) [name: 'idx_users_role_active', note: '依角色篩選未軟刪除的有效帳號，驗證管理員權限（FR-017）']
  }

  Note: 'D1：Key Entities 使用者帳號；FR-017 只允許管理員設定送修、停用與恢復可用，一般成員呼叫時拒絕；FR-008 提供最近一次狀態變更的管理員名稱；FR-018 保留前四次迭代預建的一般成員與管理員帳號，欄位與索引不變；SC-005 一般成員呼叫 100% 被拒絕。刪除帳號時設定 deleted_at，不物理刪除資料列；查詢有效帳號時排除 deleted_at 不為 null 的資料列。'
}

Table captcha_challenges {
  id uuid [pk, note: '驗證碼挑戰唯一識別碼']
  captcha_code varchar(7) [not null, note: '同時含英文與阿拉伯數字的 7 位數驗證碼，比對時區分大小寫（FR-018）']
  expires_at timestamptz [not null, note: '到期時間點（建立後 5 分鐘，FR-018）']
  consumed_at timestamptz [note: '送出登入驗證或重整替換而失效的時間點；尚未使用時為 null（FR-018）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；未登入操作時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null']

  indexes {
    (expires_at, consumed_at) [name: 'idx_captcha_challenges_validity', note: '加速驗證挑戰是否仍在有效期限內且尚未被消耗（FR-018）']
  }

  Note: 'D1：登入驗證碼挑戰（支撐 Key Entities 使用者帳號的登入）；FR-018 完整保留前四次迭代的驗證碼登入，欄位與索引不變；SC-005 既有功能回歸測試 100% 通過。刪除時設定 deleted_at，不物理刪除資料列；查詢有效挑戰時排除 deleted_at 不為 null、consumed_at 不為 null 或已超過 expires_at 的資料列。'
}

Table sessions {
  id uuid [pk, note: '工作階段唯一識別碼']
  token varchar(128) [not null, unique, note: '登入成功後簽發的不透明 Bearer session token（FR-018）']
  user_id uuid [not null, note: '所屬使用者帳號 ID，用於判斷本人與管理員角色（FR-017）']
  expires_at timestamptz [not null, note: '工作階段到期時間點（FR-018）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；系統操作時為 null']
  deleted_at timestamptz [note: '軟刪除時間（登出時設定 deleted_at 使工作階段立即失效）；未刪除時為 null']

  indexes {
    (user_id, deleted_at) [name: 'idx_sessions_user_active', note: '依使用者查詢未軟刪除的有效工作階段（FR-017）']
    expires_at [name: 'idx_sessions_expires_at', note: '加速檢查工作階段有效期限（FR-018）']
  }

  Note: 'D1：登入工作階段（支撐 Key Entities 使用者帳號的身分與角色驗證）；FR-017 攔截一般成員呼叫設定送修、停用與恢復可用；FR-018 保留前四次迭代的工作階段與登出，欄位與索引不變；SC-005 越權呼叫 100% 被拒絕。登出時設定 deleted_at，不物理刪除資料列；查詢有效工作階段時排除 deleted_at 不為 null 或已超過 expires_at 的資料列。'
}

// D2 設備狀態與設備狀態變更紀錄持久化
Table equipments {
  id uuid [pk, note: '設備唯一識別碼']
  equipment_code varchar(32) [not null, unique, note: '唯一設備編號（例如 EQ-101～EQ-106），顯示於設備清單與確認視窗（FR-001、FR-008）']
  name varchar(120) [not null, note: '單件設備名稱；停用設備的名稱仍顯示於成員的歷史紀錄（FR-016）']
  category varchar(64) [not null, note: '設備分類（FR-018）']
  status equipment_status [not null, default: 'available', note: '設備目前狀態：available、maintenance、retired；只有 available 可以被預約；送修中與停用之間可以直接切換，不需先恢復成可用（FR-001、FR-006、FR-010、FR-011、FR-014）']
  requires_approval boolean [not null, default: false, note: '是否需要管理員人工審核；設為送修、停用與恢復可用時都不改變此欄，恢復後的新預約依此設定直接成立或進入待審核（FR-013、SC-004）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同；狀態變更或切換審核設定時更新']
  updated_by uuid [note: '最後修改者的使用者 ID；管理員變更狀態或切換審核設定時記錄管理員 ID，系統預建時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null。停用以 status = retired 表示，不設定此欄；本次不提供刪除設備']

  indexes {
    (category, status) [name: 'idx_equipments_category_status', note: '依分類與狀態查詢設備清單，成員設備清單排除 status = retired（FR-014）']
    (requires_approval, status) [name: 'idx_equipments_approval_status', note: '依人工審核設定與狀態篩選設備（FR-013）']
  }

  Note: 'D2：Key Entities 設備；FR-001 設為送修或停用時只更新 status，不刪除設備與其歷史紀錄；FR-006 非 available 設備拒絕新預約；FR-009 設定送修或停用、成員新預約、核准待審預約與核准改期都先鎖定此表的設備列再讀寫預約，使操作序列化；FR-010 送修中與停用直接切換；FR-011 恢復可用時 status 改回 available；FR-013 保留 requires_approval；FR-014 成員設備清單顯示 maintenance、排除 retired；FR-018 遷移時 unavailable 原地改名為 retired，其餘欄位與索引不變。設備不被實體刪除；刪除資料時設定 deleted_at，查詢有效設備時排除 deleted_at 不為 null 的資料列。'
}

Table equipment_status_changes {
  id uuid [pk, note: '設備狀態變更紀錄唯一識別碼']
  equipment_id uuid [not null, note: '被變更狀態的設備 ID（FR-008）']
  from_status equipment_status [not null, note: '變更前狀態；必須與 to_status 不同（FR-008、FR-010）']
  to_status equipment_status [not null, note: '變更後狀態（FR-008、FR-010、FR-011）']
  changed_by uuid [not null, note: '經手管理員的使用者 ID，設備清單以此顯示最近一次變更的管理員名稱（FR-008、FR-017）']
  changed_at timestamptz [not null, note: '變更時間點（UTC），與同一次操作被取消預約的 cancelled_at 相同；設備清單顯示最近一次變更時間（FR-008）']
  cancelled_reservation_count integer [not null, default: 0, note: '這次變更被取消的預約數，大於或等於 0；恢復可用時為 0（FR-002、FR-003、FR-008、FR-012）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；紀錄只新增不修改，因此維持與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；建立時為經手管理員 ID，與 changed_by 相同']
  deleted_at timestamptz [note: '軟刪除時間；紀錄不得刪除，維持為 null']

  indexes {
    (equipment_id, changed_at) [name: 'idx_equipment_status_changes_equipment_changed', note: '設備清單依設備取最近一次狀態變更（changed_at 最大的一筆）（FR-008、NFR-002）']
  }

  Note: 'D2：Key Entities 設備狀態變更紀錄；FR-008 每次設定送修、停用或恢復可用都在同一交易內新增一筆，保存設備、變更前後狀態、經手管理員、變更時間與被取消的預約數，設備清單顯示最近一次變更；FR-010 送修中與停用直接切換也新增一筆；FR-011 恢復可用新增一筆且 cancelled_reservation_count 為 0；FR-019 確認時狀態或數量不同而拒絕時交易回滾，不新增紀錄；FR-018 遷移時新增此表，既有設備沒有變更紀錄。紀錄只新增、不修改、不刪除，不提供設定 deleted_at 的操作；查詢有效紀錄時排除 deleted_at 不為 null 的資料列。'
}

// D3 預約借還紀錄（含取消原因）與改期申請持久化
Table time_slots {
  id uuid [pk, note: '固定時段唯一識別碼']
  slot_code varchar(32) [not null, unique, note: '固定時段代碼（morning、afternoon、evening，FR-018）']
  name varchar(32) [not null, note: '時段名稱（上午、下午、晚間）（FR-016）']
  start_time varchar(5) [not null, note: '單日時段開始時間 HH:mm（09:00、13:00、18:00，依 Asia/Taipei 解讀），與 reservation_date 組合判斷時段是否已開始（FR-002、FR-003）']
  end_time varchar(5) [not null, note: '單日時段結束時間 HH:mm（12:00、17:00、21:00，依 Asia/Taipei 解讀），與 reservation_date 組合判斷時段是否已結束，決定設定送修或停用時要取消的預約範圍（FR-002、FR-003）']
  sort_order integer [not null, unique, note: '時段排序順序（1=上午、2=下午、3=晚間）（FR-018）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；系統預建時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null']

  Note: 'D3：Key Entities 固定時段定義；FR-002 與 FR-003 依 reservation_date 加上 end_time（Asia/Taipei）判斷時段尚未結束，決定設定送修或停用時取消的預約；FR-018 保留每日上午、下午、晚間 3 個固定時段，欄位不變。刪除時設定 deleted_at，不物理刪除資料列；查詢有效時段時排除 deleted_at 不為 null 的資料列。'
}

Table reservations {
  id uuid [pk, note: '預約與借用紀錄唯一識別碼']
  reservation_no varchar(32) [not null, unique, note: '顯示用唯一預約編號（例如 RV-20261108-14）（FR-015、FR-020）']
  user_id uuid [not null, note: '預約成員的使用者 ID；全體預約管理頁以此找出受影響的成員（FR-020）']
  equipment_id uuid [not null, note: '預約設備 ID；設備送修或停用後，在該設備上的歷史紀錄仍可查詢並顯示設備名稱（FR-016）']
  reservation_date date [not null, note: '預約日期 YYYY-MM-DD（依 Asia/Taipei 解讀）（FR-002、FR-003）']
  slot_id uuid [not null, note: '預約固定時段 ID（FR-002、FR-003）']
  status reservation_status [not null, default: 'confirmed', note: '預約 6 態狀態；設定送修或停用時，時段尚未結束的 pending_approval 與尚未登記領取的 confirmed 改為 cancelled；returned、rejected、cancelled 不改變（FR-002、FR-003、SC-001）']
  cancel_reason reservation_cancel_reason [note: '取消原因；status = cancelled 時必填，其他狀態為 null。成員本人取消為 member_cancelled，設備送修為 equipment_maintenance，設備停用為 equipment_retired；遷移時既有 cancelled 資料列補上 member_cancelled（FR-002、FR-015、FR-018、FR-020）']
  reviewed_by uuid [note: '核准或駁回此預約申請的管理員 ID（FR-018）']
  reviewed_at timestamptz [note: '核准或駁回此預約申請的時間點（UTC）（FR-018）']
  reject_reason varchar(200) [note: '駁回此預約申請時選填的原因（上限 200 字）（FR-018）']
  checked_out_by uuid [note: '執行登記領取的管理員 ID；尚未領取時為 null（FR-003、FR-018）']
  checked_out_at timestamptz [note: '登記領取時間點（UTC）；尚未領取時為 null，設定送修或停用時以此判斷 confirmed 預約尚未領取（FR-003）']
  returned_by uuid [note: '執行登記歸還的管理員 ID；尚未歸還時為 null（FR-018）']
  returned_at timestamptz [note: '登記歸還時間點（UTC）；尚未歸還時為 null（FR-018）']
  cancelled_at timestamptz [note: '取消時間點（UTC）；取消時填入並將 status 改為 cancelled，保留原資料列；因設備送修或停用取消時，等於 equipment_status_changes.changed_at（FR-002、FR-015）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間（預約送出時間點）']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同；因設備送修或停用取消時更新']
  updated_by uuid [note: '最後修改者的使用者 ID；因設備送修或停用取消時記錄經手管理員 ID']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null']

  indexes {
    (equipment_id, reservation_date, slot_id) [unique, name: 'uq_reservations_active_slot', note: '僅在 status IN (confirmed, checked_out, returned) 且 deleted_at IS NULL 時生效（PostgreSQL partial unique index：WHERE status IN (\'confirmed\', \'checked_out\', \'returned\') AND deleted_at IS NULL）；因設備送修或停用取消的預約不再占用時段，設備恢復可用後任何成員都可以重新預約（FR-011、FR-012、FR-018）']
    (user_id, equipment_id, reservation_date, slot_id) [unique, name: 'uq_reservations_user_active_request', note: '僅在 status IN (pending_approval, confirmed, checked_out) 且 deleted_at IS NULL 時生效（PostgreSQL partial unique index：WHERE status IN (\'pending_approval\', \'confirmed\', \'checked_out\') AND deleted_at IS NULL）；同一成員在同一設備、日期與時段不得有兩筆未結束預約（FR-018）']
    (status, reservation_date, slot_id, created_at) [name: 'idx_reservations_status_date_slot', note: '管理員依狀態篩選全體預約並排序，含篩選已取消時顯示取消原因（FR-020、FR-018）']
    (user_id, status, reservation_date, created_at) [name: 'idx_reservations_user_date_created', note: '成員「我的預約」查詢本人預約與歷史紀錄（FR-015、FR-016）']
    (reservation_date, slot_id, created_at) [name: 'idx_reservations_date_slot_created', note: '管理員查詢全體預約借還清單（FR-020、FR-018）']
    (reservation_date, equipment_id, status) [name: 'idx_reservations_date_equipment_status', note: '依日期查詢各設備固定時段的占用狀態（FR-014、FR-018）']
    (equipment_id, status, reservation_date) [name: 'idx_reservations_equipment_status_date', note: '本次新增：依設備與狀態找出借用中預約、計算將取消的預約數，並批次取消時段尚未結束的 pending_approval 與 confirmed 預約；一台設備 100 筆以內未結束預約時操作低於 2 秒（FR-002、FR-003、FR-005、FR-007、FR-019、NFR-002、SC-006）']
  }

  Note: 'D3：Key Entities 預約與借用紀錄；FR-002 與 FR-003 設定送修或停用時在同一交易內，把這台設備時段尚未結束的 pending_approval 與尚未登記領取的 confirmed 預約改為 cancelled，填入 cancel_reason、cancelled_at 與 updated_by；FR-005 設備有 checked_out 預約時拒絕設定；FR-007 與 FR-019 預覽與確認時以相同條件計算將取消的預約數；FR-012 恢復可用時不讀取也不修改此表；FR-015 與 FR-020 以 cancel_reason 顯示取消原因；FR-016 送修中或停用設備上的歷史紀錄照常查詢；FR-018 遷移時新增 cancel_reason 並為既有 cancelled 資料列補上 member_cancelled，其餘欄位值不變；SC-001 已結束紀錄變動率 0%。取消、駁回、歸還時以 status 與對應時間欄位保留原資料列，不物理刪除；刪除資料時設定 deleted_at，查詢有效資料時排除 deleted_at 不為 null 的資料列。'
}

Table reschedule_requests {
  id uuid [pk, note: '改期申請唯一識別碼']
  request_no varchar(32) [not null, unique, note: '顯示用唯一改期申請編號（例如 RR-20261110-01）（FR-004）']
  reservation_id uuid [not null, note: '所屬預約 ID；所屬預約因設備送修或停用被取消時，以此找出改期審核中的申請（FR-004）']
  user_id uuid [not null, note: '申請成員的使用者 ID，必須為所屬預約的本人（FR-018）']
  from_reservation_date date [not null, note: '原預約日期 YYYY-MM-DD（依 Asia/Taipei 解讀）（FR-018）']
  from_slot_id uuid [not null, note: '原固定時段 ID（FR-018）']
  to_reservation_date date [not null, note: '新預約日期 YYYY-MM-DD（依 Asia/Taipei 解讀）（FR-018）']
  to_slot_id uuid [not null, note: '新固定時段 ID（FR-018）']
  status reschedule_request_status [not null, default: 'pending_approval', note: '改期申請 5 態；所屬預約因設備送修或停用被取消時，pending_approval 改為 expired，之後不能核准；設備恢復可用時不復原（FR-004、FR-012）']
  reviewed_by uuid [note: '核准或駁回的管理員 ID；失效時為 null（FR-018）']
  reviewed_at timestamptz [note: '管理員核准或駁回的時間點（UTC）；失效時為 null（FR-018）']
  reject_reason varchar(200) [note: '駁回時選填的原因，上限 200 字；非 rejected 時為 null（FR-018）']
  withdrawn_at timestamptz [note: '成員撤回的時間點（UTC）；非 withdrawn 時為 null（FR-018）']
  expired_at timestamptz [note: '失效時間點（UTC）；因設備送修或停用取消原預約而失效時，等於該次 equipment_status_changes.changed_at；非 expired 時為 null（FR-004）']
  expire_reason reschedule_expire_reason [note: '失效原因；因設備送修或停用取消原預約而失效時為 reservation_cancelled（原預約已取消）；非 expired 時為 null（FR-004）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間，即改期申請時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；因設備送修或停用而失效時記錄經手管理員 ID，因時段開始而自動失效時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null']

  indexes {
    (reservation_id) [unique, name: 'uq_reschedule_requests_pending_per_reservation', note: '僅在 status = pending_approval 且 deleted_at IS NULL 時生效（PostgreSQL partial unique index：WHERE status = \'pending_approval\' AND deleted_at IS NULL）；同一筆預約同時最多一筆改期審核中的申請，設定送修或停用時以此找出要失效的申請（FR-004、FR-018）']
    (status, to_reservation_date, to_slot_id, created_at) [name: 'idx_reschedule_requests_status_to_slot', note: '管理員待審清單列出改期審核中申請，失效的申請不再出現（FR-004、FR-018）']
    (reservation_id, created_at) [name: 'idx_reschedule_requests_reservation_created', note: '「我的預約」依預約列出改期紀錄，含因原預約已取消而失效的申請（FR-004、FR-012）']
  }

  Note: 'D3：Key Entities 改期申請；FR-004 所屬預約依 FR-002、FR-003 被取消時，在同一交易內把 pending_approval 申請改為 expired，expire_reason 為 reservation_cancelled，之後不能核准；FR-007 與 FR-019 預覽與確認時以相同條件計算將失效的改期申請數；FR-012 設備恢復可用時不復原；FR-018 欄位、Enum 與索引與 006 相同，既有資料列無損保留。申請進入終態後保留原資料列與歷程，不物理刪除也不覆寫；刪除資料時設定 deleted_at，查詢有效資料時排除 deleted_at 不為 null 的資料列。'
}

// ---------- Table Groups ----------

TableGroup d1_auth_and_session_access [note: 'D1 帳號、驗證碼挑戰與工作階段資料存取'] {
  users
  captcha_challenges
  sessions
}

TableGroup d2_equipment_status_persistence [note: 'D2 設備狀態與設備狀態變更紀錄持久化'] {
  equipments
  equipment_status_changes
}

TableGroup d3_reservation_and_reschedule_persistence [note: 'D3 預約借還紀錄（含取消原因）與改期申請持久化'] {
  time_slots
  reservations
  reschedule_requests
}

// ---------- Relationships ----------

Ref: sessions.user_id > users.id
Ref: equipment_status_changes.equipment_id > equipments.id
Ref: equipment_status_changes.changed_by > users.id
Ref: reservations.user_id > users.id
Ref: reservations.reviewed_by > users.id
Ref: reservations.checked_out_by > users.id
Ref: reservations.returned_by > users.id
Ref: reservations.equipment_id > equipments.id
Ref: reservations.slot_id > time_slots.id
Ref: reschedule_requests.reservation_id > reservations.id
Ref: reschedule_requests.user_id > users.id
Ref: reschedule_requests.reviewed_by > users.id
Ref: reschedule_requests.from_slot_id > time_slots.id
Ref: reschedule_requests.to_slot_id > time_slots.id
