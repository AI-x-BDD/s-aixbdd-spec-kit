generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  member
  admin
}

enum equipment_status {
  available
  unavailable
}

enum reservation_status {
  confirmed
  cancelled
}

model users {
  id            String         @id @default(uuid()) @db.Uuid
  username      String         @unique @db.VarChar(64)
  password_hash String         @db.VarChar(255)
  display_name  String         @db.VarChar(100)
  role          user_role      @default(member)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_by    String?        @db.Uuid
  deleted_at    DateTime?      @db.Timestamptz(6)
  sessions      sessions[]
  reservations  reservations[]

  @@index([role, deleted_at], map: "idx_users_role_active")
}

model captcha_challenges {
  id           String    @id @default(uuid()) @db.Uuid
  captcha_code String    @db.VarChar(7)
  expires_at   DateTime  @db.Timestamptz(6)
  consumed_at  DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_by   String?   @db.Uuid
  deleted_at   DateTime? @db.Timestamptz(6)

  @@index([expires_at, consumed_at], map: "idx_captcha_challenges_validity")
}

model sessions {
  id         String    @id @default(uuid()) @db.Uuid
  token      String    @unique @db.VarChar(128)
  user_id    String    @db.Uuid
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz(6)
  user       users     @relation(fields: [user_id], references: [id])

  @@index([user_id, deleted_at], map: "idx_sessions_user_active")
  @@index([expires_at], map: "idx_sessions_expires_at")
}

model equipments {
  id             String           @id @default(uuid()) @db.Uuid
  equipment_code String           @unique @db.VarChar(32)
  name           String           @db.VarChar(120)
  category       String           @db.VarChar(64)
  status         equipment_status @default(available)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_by     String?          @db.Uuid
  deleted_at     DateTime?        @db.Timestamptz(6)
  reservations   reservations[]

  @@index([category, status], map: "idx_equipments_category_status")
}

model time_slots {
  id           String         @id @default(uuid()) @db.Uuid
  slot_code    String         @unique @db.VarChar(32)
  name         String         @db.VarChar(32)
  start_time   String         @db.VarChar(5)
  end_time     String         @db.VarChar(5)
  sort_order   Int            @unique
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_by   String?        @db.Uuid
  deleted_at   DateTime?      @db.Timestamptz(6)
  reservations reservations[]
}

model reservations {
  id               String             @id @default(uuid()) @db.Uuid
  reservation_no   String             @unique @db.VarChar(32)
  user_id          String             @db.Uuid
  equipment_id     String             @db.Uuid
  reservation_date DateTime           @db.Date
  slot_id          String             @db.Uuid
  status           reservation_status @default(confirmed)
  cancelled_at     DateTime?          @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_by       String?            @db.Uuid
  deleted_at       DateTime?          @db.Timestamptz(6)
  user             users              @relation(fields: [user_id], references: [id])
  equipment        equipments         @relation(fields: [equipment_id], references: [id])
  slot             time_slots         @relation(fields: [slot_id], references: [id])

  @@unique([equipment_id, reservation_date, slot_id], map: "uq_reservations_active_slot", where: { status: "confirmed", deleted_at: null })
  @@index([user_id, reservation_date, created_at], map: "idx_reservations_user_date_created")
  @@index([reservation_date, slot_id, created_at], map: "idx_reservations_date_slot_created")
  @@index([reservation_date, equipment_id, status], map: "idx_reservations_date_equipment_status")
}
