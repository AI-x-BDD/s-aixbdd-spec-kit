generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  member
  admin
}

enum equipment_status {
  available
  maintenance
  retired
}

enum reservation_status {
  pending_approval
  confirmed
  checked_out
  returned
  rejected
  cancelled
}

enum reservation_cancel_reason {
  member_cancelled
  equipment_maintenance
  equipment_retired
}

enum reschedule_request_status {
  pending_approval
  approved
  rejected
  withdrawn
  expired
}

enum reschedule_expire_reason {
  original_slot_started
  new_slot_started
  reservation_cancelled
  reservation_checked_out
}

model users {
  id                       String                     @id @default(uuid()) @db.Uuid
  username                 String                     @unique @db.VarChar(64)
  password_hash            String                     @db.VarChar(255)
  display_name             String                     @db.VarChar(100)
  role                     user_role                  @default(member)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_by               String?                    @db.Uuid
  deleted_at               DateTime?                  @db.Timestamptz(6)
  sessions                 sessions[]
  reservations             reservations[]             @relation("ReservationApplicant")
  reviewed_reservations    reservations[]             @relation("ReservationReviewer")
  checked_out_reservations reservations[]             @relation("ReservationCheckoutAdmin")
  returned_reservations    reservations[]             @relation("ReservationReturnAdmin")
  reschedule_requests      reschedule_requests[]      @relation("RescheduleApplicant")
  reviewed_reschedules     reschedule_requests[]      @relation("RescheduleReviewer")
  equipment_status_changes equipment_status_changes[]

  @@index([role, deleted_at], map: "idx_users_role_active")
}

model captcha_challenges {
  id           String    @id @default(uuid()) @db.Uuid
  captcha_code String    @db.VarChar(7)
  expires_at   DateTime  @db.Timestamptz(6)
  consumed_at  DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_by   String?   @db.Uuid
  deleted_at   DateTime? @db.Timestamptz(6)

  @@index([expires_at, consumed_at], map: "idx_captcha_challenges_validity")
}

model sessions {
  id         String    @id @default(uuid()) @db.Uuid
  token      String    @unique @db.VarChar(128)
  user_id    String    @db.Uuid
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz(6)
  user       users     @relation(fields: [user_id], references: [id])

  @@index([user_id, deleted_at], map: "idx_sessions_user_active")
  @@index([expires_at], map: "idx_sessions_expires_at")
}

model equipments {
  id                String                     @id @default(uuid()) @db.Uuid
  equipment_code    String                     @unique @db.VarChar(32)
  name              String                     @db.VarChar(120)
  category          String                     @db.VarChar(64)
  status            equipment_status           @default(available)
  requires_approval Boolean                    @default(false)
  created_at        DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                   @default(now()) @db.Timestamptz(6)
  updated_by        String?                    @db.Uuid
  deleted_at        DateTime?                  @db.Timestamptz(6)
  reservations      reservations[]
  status_changes    equipment_status_changes[]

  @@index([category, status], map: "idx_equipments_category_status")
  @@index([requires_approval, status], map: "idx_equipments_approval_status")
}

model equipment_status_changes {
  id                          String           @id @default(uuid()) @db.Uuid
  equipment_id                String           @db.Uuid
  from_status                 equipment_status
  to_status                   equipment_status
  changed_by                  String           @db.Uuid
  changed_at                  DateTime         @db.Timestamptz(6)
  cancelled_reservation_count Int              @default(0)
  created_at                  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime         @default(now()) @db.Timestamptz(6)
  updated_by                  String?          @db.Uuid
  deleted_at                  DateTime?        @db.Timestamptz(6)
  equipment                   equipments       @relation(fields: [equipment_id], references: [id])
  changer                     users            @relation(fields: [changed_by], references: [id])

  @@index([equipment_id, changed_at], map: "idx_equipment_status_changes_equipment_changed")
}

model time_slots {
  id               String                @id @default(uuid()) @db.Uuid
  slot_code        String                @unique @db.VarChar(32)
  name             String                @db.VarChar(32)
  start_time       String                @db.VarChar(5)
  end_time         String                @db.VarChar(5)
  sort_order       Int                   @unique
  created_at       DateTime              @default(now()) @db.Timestamptz(6)
  updated_at       DateTime              @default(now()) @db.Timestamptz(6)
  updated_by       String?               @db.Uuid
  deleted_at       DateTime?             @db.Timestamptz(6)
  reservations     reservations[]
  reschedules_from reschedule_requests[] @relation("RescheduleFromSlot")
  reschedules_to   reschedule_requests[] @relation("RescheduleToSlot")
}

model reservations {
  id                  String                     @id @default(uuid()) @db.Uuid
  reservation_no      String                     @unique @db.VarChar(32)
  user_id             String                     @db.Uuid
  equipment_id        String                     @db.Uuid
  reservation_date    DateTime                   @db.Date
  slot_id             String                     @db.Uuid
  status              reservation_status         @default(confirmed)
  cancel_reason       reservation_cancel_reason?
  reviewed_by         String?                    @db.Uuid
  reviewed_at         DateTime?                  @db.Timestamptz(6)
  reject_reason       String?                    @db.VarChar(200)
  checked_out_by      String?                    @db.Uuid
  checked_out_at      DateTime?                  @db.Timestamptz(6)
  returned_by         String?                    @db.Uuid
  returned_at         DateTime?                  @db.Timestamptz(6)
  cancelled_at        DateTime?                  @db.Timestamptz(6)
  created_at          DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                   @default(now()) @db.Timestamptz(6)
  updated_by          String?                    @db.Uuid
  deleted_at          DateTime?                  @db.Timestamptz(6)
  user                users                      @relation("ReservationApplicant", fields: [user_id], references: [id])
  reviewer            users?                     @relation("ReservationReviewer", fields: [reviewed_by], references: [id])
  checkout_admin      users?                     @relation("ReservationCheckoutAdmin", fields: [checked_out_by], references: [id])
  return_admin        users?                     @relation("ReservationReturnAdmin", fields: [returned_by], references: [id])
  equipment           equipments                 @relation(fields: [equipment_id], references: [id])
  slot                time_slots                 @relation(fields: [slot_id], references: [id])
  reschedule_requests reschedule_requests[]

  @@unique([equipment_id, reservation_date, slot_id], map: "uq_reservations_active_slot", where: raw("status IN ('confirmed', 'checked_out', 'returned') AND deleted_at IS NULL"))
  @@unique([user_id, equipment_id, reservation_date, slot_id], map: "uq_reservations_user_active_request", where: raw("status IN ('pending_approval', 'confirmed', 'checked_out') AND deleted_at IS NULL"))
  @@index([status, reservation_date, slot_id, created_at], map: "idx_reservations_status_date_slot")
  @@index([user_id, status, reservation_date, created_at], map: "idx_reservations_user_date_created")
  @@index([reservation_date, slot_id, created_at], map: "idx_reservations_date_slot_created")
  @@index([reservation_date, equipment_id, status], map: "idx_reservations_date_equipment_status")
  @@index([equipment_id, status, reservation_date], map: "idx_reservations_equipment_status_date")
}

model reschedule_requests {
  id                    String                    @id @default(uuid()) @db.Uuid
  request_no            String                    @unique @db.VarChar(32)
  reservation_id        String                    @db.Uuid
  user_id               String                    @db.Uuid
  from_reservation_date DateTime                  @db.Date
  from_slot_id          String                    @db.Uuid
  to_reservation_date   DateTime                  @db.Date
  to_slot_id            String                    @db.Uuid
  status                reschedule_request_status @default(pending_approval)
  reviewed_by           String?                   @db.Uuid
  reviewed_at           DateTime?                 @db.Timestamptz(6)
  reject_reason         String?                   @db.VarChar(200)
  withdrawn_at          DateTime?                 @db.Timestamptz(6)
  expired_at            DateTime?                 @db.Timestamptz(6)
  expire_reason         reschedule_expire_reason?
  created_at            DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                  @default(now()) @db.Timestamptz(6)
  updated_by            String?                   @db.Uuid
  deleted_at            DateTime?                 @db.Timestamptz(6)
  reservation           reservations              @relation(fields: [reservation_id], references: [id])
  user                  users                     @relation("RescheduleApplicant", fields: [user_id], references: [id])
  reviewer              users?                    @relation("RescheduleReviewer", fields: [reviewed_by], references: [id])
  from_slot             time_slots                @relation("RescheduleFromSlot", fields: [from_slot_id], references: [id])
  to_slot               time_slots                @relation("RescheduleToSlot", fields: [to_slot_id], references: [id])

  @@unique([reservation_id], map: "uq_reschedule_requests_pending_per_reservation", where: raw("status = 'pending_approval' AND deleted_at IS NULL"))
  @@index([status, to_reservation_date, to_slot_id, created_at], map: "idx_reschedule_requests_status_to_slot")
  @@index([reservation_id, created_at], map: "idx_reschedule_requests_reservation_created")
}
