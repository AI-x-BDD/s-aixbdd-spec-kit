// Data Model: 逾期借用的 Discord 通知、送出結果查看與重送、手動逾期檢查 (Overdue Discord Notification)
// Spec: specs/008-overdue-discord-notification/spec.md
// Date: 2026-11-11

Project "overdue-discord-notification" {
  database_type: 'PostgreSQL'
  Note: '涵蓋 D1 逾期通知紀錄持久化，D2 前五版帳號、設備、固定時段、預約借還、改期與設備狀態變更資料存取與無損遷移。延續 007-equipment-maintenance-retire 的 users、captcha_challenges、sessions、equipments、equipment_status_changes、time_slots、reservations、reschedule_requests 結構，本次不修改任何既有資料表、欄位、Enum 與索引；只以一支增量遷移新增 overdue_notification_status、overdue_notification_failure_reason 兩個 Enum 與 overdue_notifications 資料表，既有資料列完全不改寫，達成無損遷移（FR-020）。逾期借用不新增狀態，由 reservations.status = checked_out 加上 time_slots.end_time 判定（FR-011）。資料庫不保存 Discord Webhook 位址（NFR-003）。每張持久化資料表皆具備生命週期欄位並採用軟刪除（設定 deleted_at），查詢有效資料時皆排除 deleted_at 不為 null 的資料列。'
}

// ---------- Enums ----------

Enum overdue_notification_status {
  sending [note: '送出中：建立通知或管理員重送時的狀態；next_attempt_at 有值代表等待送出或等待自動重試（Discord 確定沒收到），next_attempt_at 為 null 代表請求已送出、正在等待 Discord 回應；系統恢復運作時，前者繼續自動重試，後者改為 unknown（FR-005、FR-017、FR-021）']
  sent [note: '送出成功：Discord 以 ?wait=true 回傳訊息，記錄 sent_at 與 discord_message_id；不能重送（FR-007、FR-017）']
  failed [note: '送出失敗：自動重試 3 次後仍失敗、Discord 要求等待超過 1 分鐘，或不會自己恢復的失敗；記錄 failure_reason，之後不再自動重試，借用仍為 checked_out 時管理員可以重送（FR-005、FR-014、FR-015、FR-017）']
  unknown [note: '結果不明：送出後 10 秒沒有回應、送出後連線中斷，或系統恢復運作時仍在等待 Discord 回應；不自動重試也不自動重送，借用仍為 checked_out 時管理員確認後可以重送（FR-006、FR-016、FR-017、FR-021）']
}

Enum overdue_notification_failure_reason {
  rate_limited [note: 'Discord 請求太頻繁：429 且 3 次自動重試後仍失敗，或要求等待超過 60 秒（FR-014、NFR-002）']
  discord_server_error [note: 'Discord 伺服器錯誤：5xx 且 3 次自動重試後仍失敗（FR-014、NFR-002）']
  connection_failed [note: '無法連線：連線在訊息送出前就失敗（例如 ECONNREFUSED、ENOTFOUND）且 3 次自動重試後仍失敗（FR-014、NFR-002）']
  webhook_invalid [note: '通知設定有誤：Webhook 已失效（401、403、404），不自動重試（FR-015、NFR-002）']
  webhook_not_configured [note: '通知設定有誤：沒有設定 Webhook 位址，不送出請求、不自動重試（FR-015、NFR-002）']
  message_rejected [note: 'Discord 拒絕訊息內容：其他 4xx，不自動重試（FR-015、NFR-002）']
}

Enum user_role {
  member [note: '一般成員：呼叫查看逾期通知紀錄、重送與手動逾期檢查時被拒絕，保留前五次迭代的成員功能（FR-019、FR-020、SC-007）']
  admin [note: '管理員：唯一可以查看逾期通知紀錄、重送通知與手動執行逾期檢查的角色，保留前五次迭代的管理員權限（FR-019、FR-020）']
}

Enum equipment_status {
  available [note: '可用；逾期借用的設備一定是此狀態，逾期判定不讀設備狀態（FR-011、FR-020）']
  maintenance [note: '送修中；借用中的設備不能設為此狀態，本次值與排序不變（FR-020）']
  retired [note: '停用；借用中的設備不能設為此狀態，本次值與排序不變（FR-020）']
}

Enum reservation_status {
  pending_approval [note: '待審核；不判定為逾期借用（FR-011、FR-020）']
  confirmed [note: '已核准／有效；尚未登記領取，不判定為逾期借用（FR-011、FR-020）']
  checked_out [note: '借用中；時段結束時間（Asia/Taipei）已過仍為此狀態即為逾期借用，不設寬限時間，本次不新增狀態；管理員重送通知時借用必須仍為此狀態（FR-008、FR-011）']
  returned [note: '已歸還；時段結束後、檢查前已歸還的不判定為逾期，通知紀錄頁顯示「已歸還」且不能重送，通知狀態不變（FR-008、FR-011）']
  rejected [note: '已駁回；不判定為逾期借用（FR-011、FR-020）']
  cancelled [note: '已取消；不判定為逾期借用（FR-011、FR-020）']
}

Enum reservation_cancel_reason {
  member_cancelled [note: '成員取消；本次值不變（FR-020）']
  equipment_maintenance [note: '設備送修；本次值不變（FR-020）']
  equipment_retired [note: '設備停用；本次值不變（FR-020）']
}

Enum reschedule_request_status {
  pending_approval [note: '改期審核中；本次值不變（FR-020）']
  approved [note: '改期成功；本次值不變（FR-020）']
  rejected [note: '改期被駁回；本次值不變（FR-020）']
  withdrawn [note: '改期已撤回；本次值不變（FR-020）']
  expired [note: '改期已失效；本次值不變（FR-020）']
}

Enum reschedule_expire_reason {
  original_slot_started [note: '原時段的開始時間到達；本次值不變（FR-020）']
  new_slot_started [note: '新時段早於原時段且開始時間先到達；本次值不變（FR-020）']
  reservation_cancelled [note: '原預約已取消；本次值不變（FR-020）']
  reservation_checked_out [note: '管理員對原預約登記領取；本次值不變（FR-020）']
}

// ---------- Tables ----------

// D1 逾期通知紀錄持久化
Table overdue_notifications {
  id uuid [pk, note: '逾期通知唯一識別碼']
  reservation_id uuid [not null, unique, note: '對應的預約與借用紀錄 ID；遷移時唯一約束命名為 uq_overdue_notifications_reservation，不設過濾條件。自動檢查與手動檢查以 INSERT ... ON CONFLICT (reservation_id) DO NOTHING 建立通知，同時執行時只有一方寫入，不論既有通知的狀態都不再建立（FR-012、FR-018、SC-002）']
  status overdue_notification_status [not null, default: 'sending', note: '通知狀態 4 態；建立與重送時為 sending，送出結束後依結果改為 sent、failed 或 unknown（FR-005、FR-017）']
  attempt_count integer [not null, default: 0, note: '累計嘗試送出次數，大於或等於 0；建立時為 0，送出程序每領取一次加 1，自動重試與管理員重送都累加，重送時不歸 0；通知紀錄頁顯示此值（FR-003、FR-005）']
  auto_retry_count integer [not null, default: 0, note: '本輪已自動重試次數，0～3；建立與管理員重送時歸 0，系統恢復運作時保留，達 3 次仍收到可重試的結果時改為 failed（FR-014、FR-021）']
  next_attempt_at timestamptz [note: '下一次送出時間點（UTC）；只在 status = sending 時有值或為 null：有值代表等待送出或等待自動重試，送出程序領取時設為 null，null 代表請求已送出、正在等待 Discord 回應；其他狀態為 null（FR-014、FR-021）']
  last_attempted_at timestamptz [note: '最後一次嘗試送出的時間點（UTC），送出程序領取時填入；尚未嘗試時為 null，通知紀錄頁顯示「—」（FR-003、FR-005）']
  failure_reason overdue_notification_failure_reason [note: '最後一次的失敗原因；status = failed 時必填，其他狀態為 null，管理員重送時清為 null。只保存原因類型，不保存例外訊息原文與 Webhook 位址（FR-003、FR-014、FR-015、NFR-002、NFR-003）']
  sent_at timestamptz [note: '送出成功時間點（UTC）；status = sent 時必填，其他狀態為 null（FR-003、FR-017）']
  discord_message_id text [note: 'Discord 回傳的訊息編號（snowflake 以字串保存，超過 JavaScript Number 安全整數範圍）；status = sent 時必填，其他狀態為 null（FR-017）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間，即逾期檢查建立通知的時間；通知紀錄頁依此由新到舊排序（FR-003）']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同，送出程序、恢復處理與重送時更新']
  updated_by uuid [note: '最後修改者的使用者 ID；管理員重送時記錄管理員 ID，自動檢查、手動檢查建立、送出程序與恢復處理修改時為 null']
  deleted_at timestamptz [note: '軟刪除時間；本次不提供刪除通知紀錄（Out of Scope），維持為 null']

  indexes {
    next_attempt_at [name: 'idx_overdue_notifications_due', note: '僅在 status = sending 時生效（PostgreSQL partial index：WHERE status = \'sending\'）；送出程序以 next_attempt_at <= 目前時間 ORDER BY next_attempt_at 搭配 FOR UPDATE SKIP LOCKED 領取到期通知，系統恢復運作時以 next_attempt_at IS NULL 找出等待 Discord 回應的通知（FR-001、FR-014、FR-018、FR-021、SC-001）']
    (status, created_at) [name: 'idx_overdue_notifications_status_created', note: '通知紀錄頁依通知狀態篩選並由新到舊排序（FR-003、FR-004）']
    created_at [name: 'idx_overdue_notifications_created', note: '通知紀錄頁不篩選狀態時依建立時間由新到舊排序（FR-003）']
  }

  Note: 'D1：Key Entities 逾期通知；FR-012 每筆預約與借用紀錄最多一則通知，reservation_id 唯一；FR-017 記錄送出中、送出成功、送出失敗、結果不明 4 態，送出成功記錄 sent_at 與 discord_message_id；FR-005 管理員重送以一條條件式更新（status IN (failed, unknown) 且 reservations.status = checked_out）把同一列改回 sending、next_attempt_at 設為目前時間、auto_retry_count 歸 0、failure_reason 清為 null，不建立新列，SC-004 通知總數不增加；FR-007 與 FR-008 條件式更新 0 列時不改變通知；FR-018 同時重送時只有一方更新成功，送出程序以 FOR UPDATE SKIP LOCKED 讓每次領取只送出一次；FR-021 以 status = sending 時 next_attempt_at 是否為 null 區分等待自動重試與等待 Discord 回應；FR-014、FR-015、FR-016 由送出結果決定 failed 或 unknown 與 failure_reason；FR-003 與 FR-004 提供清單欄位與狀態篩選；FR-020 遷移時新增此表且為空表，demo seed 寫入送出成功、送出失敗、結果不明各至少一則；NFR-003 不保存 Webhook 位址。登記歸還不修改此表，通知狀態維持原值。送出成功為終態且不再修改；送出失敗與結果不明依 FR-005 可重送，重送時更新同一列。本次不提供刪除，刪除資料時設定 deleted_at，查詢有效資料時排除 deleted_at 不為 null 的資料列。'
}

// D2 前五版帳號、設備、固定時段、預約借還、改期與設備狀態變更資料存取與無損遷移
Table users {
  id uuid [pk, note: '使用者唯一識別碼']
  username varchar(64) [not null, unique, note: '登入帳號（FR-020）']
  password_hash varchar(255) [not null, note: '以 crypto.scrypt 雜湊後的密碼字串（FR-020）']
  display_name varchar(100) [not null, note: '顯示名稱；Discord 通知內容與通知紀錄頁以 reservations.user_id 對應此欄，寫出借用成員姓名（FR-003、FR-013）']
  role user_role [not null, default: 'member', note: '使用者角色；查看逾期通知紀錄、重送與手動逾期檢查限 admin（FR-019、SC-007）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；系統預建或匿名操作時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null']

  indexes {
    (role, deleted_at) [name: 'idx_users_role_active', note: '依角色篩選未軟刪除的有效帳號，驗證管理員權限（FR-019）']
  }

  Note: 'D2：Key Entities 使用者帳號；FR-013 通知內容使用成員的 display_name；FR-019 只允許管理員查看逾期通知紀錄、重送與手動執行逾期檢查，一般成員呼叫時拒絕；FR-020 保留前五次迭代預建的一般成員與管理員帳號，本次欄位、Enum 與索引不變；SC-007 一般成員呼叫 100% 被拒絕。刪除帳號時設定 deleted_at，不物理刪除資料列；查詢有效帳號時排除 deleted_at 不為 null 的資料列。'
}

Table captcha_challenges {
  id uuid [pk, note: '驗證碼挑戰唯一識別碼']
  captcha_code varchar(7) [not null, note: '同時含英文與阿拉伯數字的 7 位數驗證碼，比對時區分大小寫（FR-020）']
  expires_at timestamptz [not null, note: '到期時間點（建立後 5 分鐘，FR-020）']
  consumed_at timestamptz [note: '送出登入驗證或重整替換而失效的時間點；尚未使用時為 null（FR-020）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；未登入操作時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null']

  indexes {
    (expires_at, consumed_at) [name: 'idx_captcha_challenges_validity', note: '加速驗證挑戰是否仍在有效期限內且尚未被消耗（FR-020）']
  }

  Note: 'D2：登入驗證碼挑戰（支撐 Key Entities 使用者帳號的登入）；FR-020 完整保留前五次迭代的驗證碼登入，本次欄位與索引不變；SC-007 既有功能回歸測試 100% 通過。刪除時設定 deleted_at，不物理刪除資料列；查詢有效挑戰時排除 deleted_at 不為 null、consumed_at 不為 null 或已超過 expires_at 的資料列。'
}

Table sessions {
  id uuid [pk, note: '工作階段唯一識別碼']
  token varchar(128) [not null, unique, note: '登入成功後簽發的不透明 Bearer session token（FR-020）']
  user_id uuid [not null, note: '所屬使用者帳號 ID，用於判斷管理員角色（FR-019）']
  expires_at timestamptz [not null, note: '工作階段到期時間點（FR-020）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；系統操作時為 null']
  deleted_at timestamptz [note: '軟刪除時間（登出時設定 deleted_at 使工作階段立即失效）；未刪除時為 null']

  indexes {
    (user_id, deleted_at) [name: 'idx_sessions_user_active', note: '依使用者查詢未軟刪除的有效工作階段（FR-019）']
    expires_at [name: 'idx_sessions_expires_at', note: '加速檢查工作階段有效期限（FR-020）']
  }

  Note: 'D2：登入工作階段（支撐 Key Entities 使用者帳號的身分與角色驗證）；FR-019 攔截一般成員查看逾期通知紀錄、重送與手動逾期檢查；FR-020 保留前五次迭代的工作階段與登出，本次欄位與索引不變；SC-007 越權呼叫 100% 被拒絕。登出時設定 deleted_at，不物理刪除資料列；查詢有效工作階段時排除 deleted_at 不為 null 或已超過 expires_at 的資料列。'
}

Table equipments {
  id uuid [pk, note: '設備唯一識別碼']
  equipment_code varchar(32) [not null, unique, note: '唯一設備編號（例如 EQ-101～EQ-106），寫進 Discord 通知並顯示於通知紀錄頁（FR-003、FR-013）']
  name varchar(120) [not null, note: '單件設備名稱，寫進 Discord 通知並顯示於通知紀錄頁（FR-003、FR-013）']
  category varchar(64) [not null, note: '設備分類（FR-020）']
  status equipment_status [not null, default: 'available', note: '設備目前狀態；逾期判定只看預約狀態與時段，不讀此欄（FR-011、FR-020）']
  requires_approval boolean [not null, default: false, note: '是否需要管理員人工審核（FR-020）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；系統預建時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null。停用以 status = retired 表示，不設定此欄']

  indexes {
    (category, status) [name: 'idx_equipments_category_status', note: '依分類與狀態查詢設備清單（FR-020）']
    (requires_approval, status) [name: 'idx_equipments_approval_status', note: '依人工審核設定與狀態篩選設備（FR-020）']
  }

  Note: 'D2：Key Entities 設備；FR-013 通知內容取 equipment_code 與 name；FR-003 通知紀錄頁顯示設備編號與名稱；FR-011 逾期判定不讀設備狀態（Edge Cases 送修或停用設備的逾期借用）；FR-020 保留前五次迭代的設備資料，本次欄位、Enum 與索引不變；US1 情境 10 升級後既有資料不變。設備不被實體刪除；刪除資料時設定 deleted_at，查詢有效設備時排除 deleted_at 不為 null 的資料列。'
}

Table equipment_status_changes {
  id uuid [pk, note: '設備狀態變更紀錄唯一識別碼']
  equipment_id uuid [not null, note: '被變更狀態的設備 ID（FR-020）']
  from_status equipment_status [not null, note: '變更前狀態（FR-020）']
  to_status equipment_status [not null, note: '變更後狀態（FR-020）']
  changed_by uuid [not null, note: '經手管理員的使用者 ID（FR-020）']
  changed_at timestamptz [not null, note: '變更時間點（UTC）（FR-020）']
  cancelled_reservation_count integer [not null, default: 0, note: '這次變更被取消的預約數，大於或等於 0（FR-020）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；紀錄只新增不修改，因此維持與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；建立時為經手管理員 ID，與 changed_by 相同']
  deleted_at timestamptz [note: '軟刪除時間；紀錄不得刪除，維持為 null']

  indexes {
    (equipment_id, changed_at) [name: 'idx_equipment_status_changes_equipment_changed', note: '設備清單依設備取最近一次狀態變更（FR-020）']
  }

  Note: 'D2：Key Entities 設備（延續 007 的設備狀態變更紀錄）；FR-020 完整保留前五次迭代的設備狀態變更資料，本次欄位與索引不變；US1 情境 10 升級後既有設備狀態變更資料不變；SC-007 既有功能回歸測試 100% 通過。紀錄只新增、不修改、不刪除；查詢有效紀錄時排除 deleted_at 不為 null 的資料列。'
}

Table time_slots {
  id uuid [pk, note: '固定時段唯一識別碼']
  slot_code varchar(32) [not null, unique, note: '固定時段代碼（morning、afternoon、evening，FR-020）']
  name varchar(32) [not null, note: '時段名稱（上午、下午、晚間），寫進 Discord 通知並顯示於通知紀錄頁（FR-003、FR-013）']
  start_time varchar(5) [not null, note: '單日時段開始時間 HH:mm（09:00、13:00、18:00，依 Asia/Taipei 解讀），寫進 Discord 通知（FR-013）']
  end_time varchar(5) [not null, note: '單日時段結束時間 HH:mm（12:00、17:00、21:00，依 Asia/Taipei 解讀），即歸還期限；逾期檢查以 (reservation_date + end_time::time) AT TIME ZONE \'Asia/Taipei\' 早於目前時間判定逾期，並計算逾期多久（FR-011、FR-013）']
  sort_order integer [not null, unique, note: '時段排序順序（1=上午、2=下午、3=晚間）（FR-020）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；系統預建時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null']

  Note: 'D2：Key Entities 固定時段定義；FR-011 時段結束時間就是歸還期限，不設寬限時間；FR-013 通知寫出預約日期與固定時段；FR-020 保留每日上午、下午、晚間 3 個固定時段，本次欄位不變。刪除時設定 deleted_at，不物理刪除資料列；查詢有效時段時排除 deleted_at 不為 null 的資料列。'
}

Table reservations {
  id uuid [pk, note: '預約與借用紀錄唯一識別碼；overdue_notifications.reservation_id 參照此欄']
  reservation_no varchar(32) [not null, unique, note: '顯示用唯一預約編號（例如 RV-20261110-12）（FR-020）']
  user_id uuid [not null, note: '借用成員的使用者 ID；通知內容與通知紀錄頁以此取得成員姓名（FR-003、FR-013）']
  equipment_id uuid [not null, note: '借用設備 ID；通知內容與通知紀錄頁以此取得設備編號與名稱（FR-003、FR-013）']
  reservation_date date [not null, note: '預約日期 YYYY-MM-DD（依 Asia/Taipei 解讀），與 time_slots.end_time 組合判定逾期（FR-011、FR-013）']
  slot_id uuid [not null, note: '預約固定時段 ID（FR-011、FR-013）']
  status reservation_status [not null, default: 'confirmed', note: '預約 6 態狀態；checked_out 且時段結束時間已過即為逾期借用；returned 時通知紀錄頁顯示「已歸還」且不能重送；本次不新增狀態（FR-008、FR-011）']
  cancel_reason reservation_cancel_reason [note: '取消原因；status = cancelled 時必填，其他狀態為 null（FR-020）']
  reviewed_by uuid [note: '核准或駁回此預約申請的管理員 ID（FR-020）']
  reviewed_at timestamptz [note: '核准或駁回此預約申請的時間點（UTC）（FR-020）']
  reject_reason varchar(200) [note: '駁回此預約申請時選填的原因（上限 200 字）（FR-020）']
  checked_out_by uuid [note: '執行登記領取的管理員 ID；尚未領取時為 null（FR-020）']
  checked_out_at timestamptz [note: '登記領取時間點（UTC）；尚未領取時為 null（FR-020）']
  returned_by uuid [note: '執行登記歸還的管理員 ID；尚未歸還時為 null（FR-008）']
  returned_at timestamptz [note: '登記歸還時間點（UTC）；通知紀錄頁在借用已歸還時顯示；尚未歸還時為 null（FR-008）']
  cancelled_at timestamptz [note: '取消時間點（UTC）；取消時填入並將 status 改為 cancelled，保留原資料列（FR-020）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間（預約送出時間點）']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null；逾期檢查排除 deleted_at 不為 null 的資料列（FR-011）']

  indexes {
    (equipment_id, reservation_date, slot_id) [unique, name: 'uq_reservations_active_slot', note: '僅在 status IN (confirmed, checked_out, returned) 且 deleted_at IS NULL 時生效（PostgreSQL partial unique index：WHERE status IN (\'confirmed\', \'checked_out\', \'returned\') AND deleted_at IS NULL）；本次不變（FR-020）']
    (user_id, equipment_id, reservation_date, slot_id) [unique, name: 'uq_reservations_user_active_request', note: '僅在 status IN (pending_approval, confirmed, checked_out) 且 deleted_at IS NULL 時生效（PostgreSQL partial unique index：WHERE status IN (\'pending_approval\', \'confirmed\', \'checked_out\') AND deleted_at IS NULL）；本次不變（FR-020）']
    (status, reservation_date, slot_id, created_at) [name: 'idx_reservations_status_date_slot', note: '逾期檢查以 status = checked_out 找出借用中預約，再依 reservation_date 與時段結束時間判定逾期；100 筆以內手動檢查低於 2 秒（FR-001、FR-009、FR-011、NFR-001、SC-005）；同時沿用為管理員依狀態篩選全體預約（FR-020）']
    (user_id, status, reservation_date, created_at) [name: 'idx_reservations_user_date_created', note: '成員「我的預約」查詢本人預約與歷史紀錄；本次不變（FR-020）']
    (reservation_date, slot_id, created_at) [name: 'idx_reservations_date_slot_created', note: '管理員查詢全體預約借還清單；本次不變（FR-020）']
    (reservation_date, equipment_id, status) [name: 'idx_reservations_date_equipment_status', note: '依日期查詢各設備固定時段的占用狀態；本次不變（FR-020）']
    (equipment_id, status, reservation_date) [name: 'idx_reservations_equipment_status_date', note: '依設備與狀態找出借用中預約與未結束預約；本次不變（FR-020）']
  }

  Note: 'D2：Key Entities 預約與借用紀錄；FR-011 status = checked_out 且 reservation_date 加上 time_slots.end_time（Asia/Taipei）早於目前時間即為逾期借用，不新增狀態或欄位，其他狀態不判定為逾期；FR-013 以 user_id、equipment_id、reservation_date、slot_id 組出通知內容；FR-008 以 status 是否為 returned 判斷借用是否已歸還，重送的條件式更新要求 status = checked_out；FR-020 本次不修改此表的欄位、Enum 與索引，既有資料列不改寫，demo seed 以「昨天」的時段建立 checked_out 的逾期借用；US1 情境 10 升級後既有資料不變。登記歸還只更新此表，不修改 overdue_notifications。取消、駁回、歸還時以 status 與對應時間欄位保留原資料列，不物理刪除；刪除資料時設定 deleted_at，查詢有效資料時排除 deleted_at 不為 null 的資料列。'
}

Table reschedule_requests {
  id uuid [pk, note: '改期申請唯一識別碼']
  request_no varchar(32) [not null, unique, note: '顯示用唯一改期申請編號（例如 RR-20261110-01）（FR-020）']
  reservation_id uuid [not null, note: '所屬預約 ID（FR-020）']
  user_id uuid [not null, note: '申請成員的使用者 ID（FR-020）']
  from_reservation_date date [not null, note: '原預約日期 YYYY-MM-DD（依 Asia/Taipei 解讀）（FR-020）']
  from_slot_id uuid [not null, note: '原固定時段 ID（FR-020）']
  to_reservation_date date [not null, note: '新預約日期 YYYY-MM-DD（依 Asia/Taipei 解讀）（FR-020）']
  to_slot_id uuid [not null, note: '新固定時段 ID（FR-020）']
  status reschedule_request_status [not null, default: 'pending_approval', note: '改期申請 5 態；本次不變（FR-020）']
  reviewed_by uuid [note: '核准或駁回的管理員 ID（FR-020）']
  reviewed_at timestamptz [note: '管理員核准或駁回的時間點（UTC）（FR-020）']
  reject_reason varchar(200) [note: '駁回時選填的原因，上限 200 字（FR-020）']
  withdrawn_at timestamptz [note: '成員撤回的時間點（UTC）（FR-020）']
  expired_at timestamptz [note: '失效時間點（UTC）（FR-020）']
  expire_reason reschedule_expire_reason [note: '失效原因；非 expired 時為 null（FR-020）']
  created_at timestamptz [not null, default: `now()`, note: '建立時間，即改期申請時間']
  updated_at timestamptz [not null, default: `now()`, note: '最後修改時間；建立時與 created_at 相同']
  updated_by uuid [note: '最後修改者的使用者 ID；自動失效時為 null']
  deleted_at timestamptz [note: '軟刪除時間；未刪除時為 null']

  indexes {
    (reservation_id) [unique, name: 'uq_reschedule_requests_pending_per_reservation', note: '僅在 status = pending_approval 且 deleted_at IS NULL 時生效（PostgreSQL partial unique index：WHERE status = \'pending_approval\' AND deleted_at IS NULL）；本次不變（FR-020）']
    (status, to_reservation_date, to_slot_id, created_at) [name: 'idx_reschedule_requests_status_to_slot', note: '管理員待審清單列出改期審核中申請；本次不變（FR-020）']
    (reservation_id, created_at) [name: 'idx_reschedule_requests_reservation_created', note: '「我的預約」依預約列出改期紀錄；本次不變（FR-020）']
  }

  Note: 'D2：Key Entities 預約與借用紀錄（延續 006、007 的改期申請）；FR-020 完整保留前五次迭代的改期資料，本次欄位、Enum 與索引不變；US1 情境 10 升級後既有改期資料不變；SC-007 既有功能回歸測試 100% 通過。申請進入終態後保留原資料列與歷程，不物理刪除也不覆寫；刪除資料時設定 deleted_at，查詢有效資料時排除 deleted_at 不為 null 的資料列。'
}

// ---------- Table Groups ----------

TableGroup d1_overdue_notification_persistence [note: 'D1 逾期通知紀錄持久化'] {
  overdue_notifications
}

TableGroup d2_legacy_data_access_and_migration [note: 'D2 前五版帳號、設備、固定時段、預約借還、改期與設備狀態變更資料存取與無損遷移'] {
  users
  captcha_challenges
  sessions
  equipments
  equipment_status_changes
  time_slots
  reservations
  reschedule_requests
}

// ---------- Relationships ----------

Ref: reservations.id - overdue_notifications.reservation_id
Ref: sessions.user_id > users.id
Ref: equipment_status_changes.equipment_id > equipments.id
Ref: equipment_status_changes.changed_by > users.id
Ref: reservations.user_id > users.id
Ref: reservations.reviewed_by > users.id
Ref: reservations.checked_out_by > users.id
Ref: reservations.returned_by > users.id
Ref: reservations.equipment_id > equipments.id
Ref: reservations.slot_id > time_slots.id
Ref: reschedule_requests.reservation_id > reservations.id
Ref: reschedule_requests.user_id > users.id
Ref: reschedule_requests.reviewed_by > users.id
Ref: reschedule_requests.from_slot_id > time_slots.id
Ref: reschedule_requests.to_slot_id > time_slots.id
